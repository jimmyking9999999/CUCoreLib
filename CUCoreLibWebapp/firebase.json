{
  "hosting": {
    "public": "dist",
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/docs/:page/index.html",
        "destination": "/docs/:page/",
        "type": 301
      },
      {
        "source": "/docs/welcome{,/**}",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/api{,/**}",
        "destination": "/llms-full.txt",
        "type": 301
      },
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap-index.xml",
        "type": 301
      }
    ]
  }
}
